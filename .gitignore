# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.env
# Virtual environments
.venv

# Raw API dumps and uncompressed PGN (large, regenerable)
data/raw/
data/clean/*.pgn
data/clean/dropped.txt

# Allow the compressed training set + Polyglot books into git
!data/clean/all.pgn.zst
# data/books/*.bin kept (regenerable but small, ~1 MB total)

# Colab session outputs (re-pulled from cloud each run)
colab_outputs/
*.lock.tmp

# Local model checkpoints (280 MB; live in HF Hub, not git)
weights/
*.pt

# Per-move feature CSVs (regenerable from raw PGNs in <15 min)
data/processed/

# Local Maia2 base model cache (downloaded at runtime)
maia2_models/

# Claude Code session state
.claude/

# Editor / OS
.idea/
.vscode/
.DS_Store
